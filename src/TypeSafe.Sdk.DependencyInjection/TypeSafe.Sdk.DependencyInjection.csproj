<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TypeSafeAI.Sdk.DependencyInjection</PackageId>
    <!-- Assembly identity intentionally remains stable across the package and namespace migration. -->
    <AssemblyName>TypeSafe.Sdk.DependencyInjection</AssemblyName>
    <RootNamespace>TypeSafeAI.DependencyInjection</RootNamespace>
    <Title>TypeSafeAI SDK for .NET — dependency injection</Title>
    <Description>Microsoft.Extensions.DependencyInjection and IHttpClientFactory integration for the TypeSafe AI .NET SDK.</Description>
    <PackageTags>typesafeai;typesafe;ai;systemone;dependency-injection;httpclientfactory;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TypeSafe.Sdk\TypeSafe.Sdk.csproj" />
  </ItemGroup>

</Project>
