<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TypeSafeAI.Sdk</PackageId>
    <!-- Assembly identity intentionally remains stable across the package and namespace migration. -->
    <AssemblyName>TypeSafe.Sdk</AssemblyName>
    <RootNamespace>TypeSafeAI</RootNamespace>
    <Title>TypeSafeAI SDK for .NET</Title>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The core client deliberately has exactly one dependency. Logging is part of the
      documented observable behaviour of the sibling SDKs, and
      Microsoft.Extensions.Logging.Abstractions is the .NET-idiomatic way to expose it.
      Retry is implemented in-library rather than delegated to Polly; see docs/design.md.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
