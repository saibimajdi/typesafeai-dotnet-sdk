<Project>

  <!--
    Central Package Management. Every package version in the repository is declared exactly
    once, here. Projects reference packages with <PackageReference Include="..." /> and no
    Version attribute, so two projects can never drift onto different versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Transitive pinning is deliberately off. When it is on, every transitive dependency is
      promoted to a direct dependency in the generated nuspec, so TypeSafeAI.Sdk ended up declaring
      Microsoft.Extensions.DependencyInjection.Abstractions merely because
      Microsoft.Extensions.Logging.Abstractions needs it. A client SDK's dependency list is part of
      its contract, so it should contain exactly what the code references and nothing more. Direct
      versions are still managed centrally, which is the part that matters here.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime dependencies of the shipping libraries. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Build-time only: packaging, API compatibility, analyzers. -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
  </ItemGroup>

  <!-- Test dependencies. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
  </ItemGroup>

</Project>
